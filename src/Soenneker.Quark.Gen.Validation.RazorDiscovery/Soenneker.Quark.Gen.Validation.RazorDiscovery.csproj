<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Run on the consumer SDK's compiler runtime, on .NET 11 or later. -->
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <!-- Compile against the oldest supported SDK API; runtime assemblies come from the selected SDK. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
