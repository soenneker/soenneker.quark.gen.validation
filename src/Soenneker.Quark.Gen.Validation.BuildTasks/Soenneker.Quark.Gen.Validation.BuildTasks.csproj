<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishAot>true</PublishAot>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
        <AssemblyName>Soenneker.Quark.Gen.Validation.BuildTasks</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.Process" Version="11.0.1612" />
        <PackageReference Include="Soenneker.Utils.File" Version="11.0.2338" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="11.0.976" />
        <PackageReference Include="Soenneker.Extensions.Enumerable.String" Version="11.0.1512" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Soenneker.Quark.Gen.Validation.RazorDiscovery/Soenneker.Quark.Gen.Validation.RazorDiscovery.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <Target Name="CopyRazorDiscovery" AfterTargets="Build">
        <ItemGroup>
            <_RazorDiscoveryOutput Include="$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Validation.RazorDiscovery/bin/$(Configuration)/net11.0/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(_RazorDiscoveryOutput)" DestinationFiles="@(_RazorDiscoveryOutput->'$(TargetDir)razor/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
    <Target Name="PublishRazorDiscovery" AfterTargets="Publish">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Validation.RazorDiscovery/Soenneker.Quark.Gen.Validation.RazorDiscovery.csproj&quot; --configuration $(Configuration) --output &quot;$(PublishDir)razor&quot; --property:PublishAot=false --property:RuntimeIdentifier= --property:SelfContained=false" />
    </Target>
</Project>
