<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishAot>true</PublishAot>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
        <AssemblyName>Soenneker.Quark.Gen.Validation.BuildTasks</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.Task" Version="11.0.141" />
        <PackageReference Include="Soenneker.Utils.PooledStringBuilders" Version="11.0.44" />
        <PackageReference Include="Soenneker.Utils.Process" Version="11.0.1602" />
        <PackageReference Include="Soenneker.Utils.File" Version="11.0.2325" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="11.0.970" />
        <PackageReference Include="Soenneker.Extensions.String" Version="4.0.800" />
        <PackageReference Include="Soenneker.Extensions.Enumerable.String" Version="11.0.1501" />
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.133" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>
    <Target Name="PublishRazorDiscovery" AfterTargets="Publish">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Validation.RazorDiscovery/Soenneker.Quark.Gen.Validation.RazorDiscovery.csproj&quot; --configuration $(Configuration) --output &quot;$(PublishDir)razor&quot; --property:PublishAot=false --property:RuntimeIdentifier= --property:SelfContained=false" />
    </Target>
</Project>
