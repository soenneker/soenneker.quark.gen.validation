<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishAot>true</PublishAot>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
        <AssemblyName>Soenneker.Quark.Gen.Validation.BuildTasks</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.Task" Version="4.0.139" />
        <PackageReference Include="Soenneker.Utils.PooledStringBuilders" Version="4.0.43" />
        <PackageReference Include="Soenneker.Utils.Dotnet" Version="4.0.2651" />
        <PackageReference Include="Soenneker.Extensions.String" Version="4.0.791" />
        <PackageReference Include="Soenneker.Extensions.Enumerable.String" Version="4.0.1491" />
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.132" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    </ItemGroup>
    <Target Name="PublishRazorDiscovery" AfterTargets="Publish">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Validation.RazorDiscovery/Soenneker.Quark.Gen.Validation.RazorDiscovery.csproj&quot; --configuration $(Configuration) --output &quot;$(PublishDir)razor&quot; --property:PublishAot=false --property:RuntimeIdentifier= --property:SelfContained=false" />
    </Target>
</Project>
