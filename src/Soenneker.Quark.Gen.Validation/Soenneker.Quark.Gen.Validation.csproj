<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <Description>External build-time validation code generation for AOT-compatible Quark applications.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.1</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Quark.Gen.Validation</AssemblyName>
        <PackageId>Soenneker.Quark.Gen.Validation</PackageId>
        <PackageTags>quark gen validation aot generator externalgenerator csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>false</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.quark.gen.validation</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.quark.gen.validation</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Quark.Gen.Validation.targets" Pack="true" PackagePath="build\" />
        <None Include="Soenneker.Quark.Gen.Validation.targets" Pack="true" PackagePath="buildTransitive\" />

    </ItemGroup>
    <PropertyGroup>
        <ValidationNativeRuntimeIdentifier Condition="'$(ValidationNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ValidationNativeRuntimeIdentifier>
        <ValidationNativeArtifactsDir Condition="'$(ValidationNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</ValidationNativeArtifactsDir>
        <_ValidationNativeExecutable>Soenneker.Quark.Gen.Validation.BuildTasks</_ValidationNativeExecutable>
        <_ValidationNativeExecutable Condition="$([System.String]::Copy('$(ValidationNativeRuntimeIdentifier)').StartsWith('win-'))">$(_ValidationNativeExecutable).exe</_ValidationNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(ValidationUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(ValidationNativeSource);../Soenneker.Quark.Gen.Validation.BuildTasks/obj/project.assets.json"
            Outputs="$(ValidationNativeArtifactsDir)/$(ValidationNativeRuntimeIdentifier)/$(_ValidationNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Validation.BuildTasks/Soenneker.Quark.Gen.Validation.BuildTasks.csproj&quot; --configuration Release --runtime $(ValidationNativeRuntimeIdentifier) --output &quot;$(ValidationNativeArtifactsDir)/$(ValidationNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <ValidationNativeSource Include="../Soenneker.Quark.Gen.Validation.BuildTasks/**/*.cs;../Soenneker.Quark.Gen.Validation.BuildTasks/*.csproj;../Soenneker.Quark.Gen.Validation.RazorDiscovery/**/*.cs;../Soenneker.Quark.Gen.Validation.RazorDiscovery/*.csproj"
                             Exclude="../Soenneker.Quark.Gen.Validation.BuildTasks/bin/**;../Soenneker.Quark.Gen.Validation.BuildTasks/obj/**;../Soenneker.Quark.Gen.Validation.RazorDiscovery/bin/**;../Soenneker.Quark.Gen.Validation.RazorDiscovery/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_ValidationRequiredRuntime Include="win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64" Condition="'$(ValidationUsePrebuiltNativeTools)' == 'true'" />
            <_ValidationNativeFile Include="$(ValidationNativeArtifactsDir)/**/*"
                                Exclude="$(ValidationNativeArtifactsDir)/**/*.pdb;$(ValidationNativeArtifactsDir)/**/*.dbg;$(ValidationNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_ValidationNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_ValidationRequiredRuntime)' != '' and !Exists('$(ValidationNativeArtifactsDir)/%(_ValidationRequiredRuntime.Identity)/Soenneker.Quark.Gen.Validation.BuildTasks') and !Exists('$(ValidationNativeArtifactsDir)/%(_ValidationRequiredRuntime.Identity)/Soenneker.Quark.Gen.Validation.BuildTasks.exe')"
               Text="Missing native validation tool for %(_ValidationRequiredRuntime.Identity)." />
        <Error Condition="'@(_ValidationNativeFile)' == ''" Text="Native validation tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
